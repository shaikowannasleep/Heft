{
  "name": "heft-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Heft Studio: level editor, balance bench and model editor for Heft (web + Electron)",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node scripts/extract_dockview_css.mjs",
    "sync-game": "node scripts/sync-game.mjs",
    "predev": "npm run sync-game",
    "dev": "vite",
    "prebuild": "npm run sync-game",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tools/smoke.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev"
  },
  "dependencies": {
    "dockview-core": "^8.4.0",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "playwright": "^1.64.0",
    "vite": "^8.3.2"
  }
}
